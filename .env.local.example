# Copy to .env.local (git-ignored), or run:  python3 -I part1-godmode/config.py --init
# Values can be literal or refer to variables exported in ~/.bashrc:
#   ~/.bashrc:   export MY_AWS_ACCOUNT=123456789012
#   .env.local:  AWS_ACCOUNT_ID=$MY_AWS_ACCOUNT
AWS_ACCOUNT_ID=$MY_AWS_ACCOUNT
AWS_CLAUDE_USER=${MY_CLAUDE_IAM_USER}
