{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InUsEast1OnlyTheseGlobalServices",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "organizations:*",
        "account:*",
        "budgets:*",
        "ce:*",
        "cur:*",
        "billing:*",
        "aws-portal:*",
        "payments:*",
        "tax:*",
        "invoicing:*",
        "freetier:*",
        "consolidatedbilling:*",
        "pricing:*",
        "support:*",
        "supportplans:*",
        "support-console:*",
        "health:*",
        "trustedadvisor:*",
        "cloudtrail:LookupEvents",
        "sso:*",
        "sso-directory:*",
        "sso-oauth:*",
        "identitystore:*",
        "identitystore-auth:*",
        "signin:*",
        "uxc:*",
        "consoleapp:*",
        "notifications:*",
        "notifications-contacts:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "unspecified"
          ]
        }
      }
    },
    {
      "Sid": "NothingAnywhereElse",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "ap-southeast-2",
            "us-east-1",
            "unspecified"
          ]
        }
      }
    }
  ]
}
