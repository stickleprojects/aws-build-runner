{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KillSwitchStopsInstancesAndSpot",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:TerminateInstances", "ec2:DescribeSpotInstanceRequests",
                 "ec2:CancelSpotInstanceRequests"],
      "Resource": "*"
    },
    {
      "Sid": "KillSwitchRemovesLeftovers",
      "Effect": "Allow",
      "Action": ["ec2:DescribeImages", "ec2:DeregisterImage", "ec2:DeleteSnapshot", "ec2:DescribeVolumes",
                 "ec2:DeleteVolume", "ec2:DescribeAddresses", "ec2:ReleaseAddress", "ec2:DescribeVpcEndpoints",
                 "ec2:DeleteVpcEndpoints", "tag:GetResources"],
      "Resource": "*"
    },
    {
      "Sid": "KillSwitchThrottlesLambdas",
      "Effect": "Allow",
      "Action": "lambda:PutFunctionConcurrency",
      "Resource": "arn:aws:lambda:ap-southeast-2:{{ACCOUNT_ID}}:function:*"
    },
    {
      "Sid": "NeverTheGuardrailLambdas",
      "Effect": "Deny",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:*:{{ACCOUNT_ID}}:function:guardrail-*"
    },
    {
      "Sid": "KillSwitchOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-southeast-2:{{ACCOUNT_ID}}:log-group:/aws/lambda/guardrail-kill-switch:*"
    },
    {
      "Sid": "BudgetActionAttachesOnlyBudgetStop",
      "Effect": "Allow",
      "Action": ["iam:AttachUserPolicy", "iam:DetachUserPolicy", "iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": ["arn:aws:iam::{{ACCOUNT_ID}}:user/{{CLAUDE_USER}}", "arn:aws:iam::{{ACCOUNT_ID}}:role/claude/*"],
      "Condition": {"ArnEquals": {"iam:PolicyARN": "arn:aws:iam::{{ACCOUNT_ID}}:policy/guardrails/budget-stop"}}
    }
  ]
}
